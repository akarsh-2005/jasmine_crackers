# Set these in Vercel > Project > Settings > Environment Variables (and in a local .env if you use build.js locally).
# Both values are PUBLIC by design (security comes from the database rules in supabase/schema.sql).
# NEVER put the Supabase "service_role" key anywhere in this project.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
